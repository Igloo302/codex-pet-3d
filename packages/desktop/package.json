{
  "name": "@codex-pet-3d/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && esbuild src/renderer/index.ts --bundle --outfile=dist/renderer/index.js --format=esm --platform=browser && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/renderer/assets',{recursive:true}); fs.copyFileSync('src/renderer/index.html','dist/renderer/index.html'); fs.cpSync('../../assets','dist/renderer/assets',{recursive:true});\"",
    "dev": "pnpm run build && node scripts/launch-electron.cjs",
    "start": "node scripts/launch-electron.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@codex-pet-3d/core": "workspace:*",
    "@codex-pet-3d/spec": "workspace:*",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.160.0",
    "electron": "^30.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
