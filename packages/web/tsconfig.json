{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@codex-pet-3d/core": ["../core/src/index.ts"],
      "@codex-pet-3d/spec": ["../spec/src/types.ts"]
    },
    "types": ["vite/client"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts"]
}
